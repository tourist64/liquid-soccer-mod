[sub_resource type="Shader" id=22]
code = "shader_type spatial;
uniform float from=0.1;
uniform float to=0.5;
render_mode unshaded;
uniform float zNear=1.0;
uniform float zFar=200;
void vertex(){
	POSITION=vec4(VERTEX,1.0);
}
float linDepth(sampler2D tex, vec2 pos,mat4 mat){
	float depth=texture(tex,pos).x;
	vec3 ndc=vec3(pos,depth) * 2.0 -1.0;
	vec4 view=mat * vec4(ndc,1.0);
	view.xyz/=view.w;
	float linear_depth=view.z;
	float scaled_depth=(zFar*zNear)/(zFar+(linear_depth*(zNear-zFar)));
	
	return scaled_depth*10.0;
}
void fragment(){
	vec3 orig =texture(SCREEN_TEXTURE,SCREEN_UV).xyz;
	float d1=linDepth(DEPTH_TEXTURE,SCREEN_UV+vec2(0.001,0.0),INV_PROJECTION_MATRIX);
	float d2=linDepth(DEPTH_TEXTURE,SCREEN_UV+vec2(-0.001,0.0),INV_PROJECTION_MATRIX);
	float d3=linDepth(DEPTH_TEXTURE,SCREEN_UV+vec2(0.0,0.001),INV_PROJECTION_MATRIX);
	float d4=linDepth(DEPTH_TEXTURE,SCREEN_UV+vec2(0.0,-0.001),INV_PROJECTION_MATRIX);
	
	d1=abs(d1-d2);
	d3=abs(d3-d4);
	d1=max(d1,d3);
	d1=smoothstep(from,to,d1);
	ALBEDO=mix(orig,vec3(10.0),d1);
	ALBEDO=vec3(d1*10.0);
	
	
}
"

