shader_param/Skin = Color( 0.807843, 0.603922, 0.603922, 1 )
shader_param/Shirt = Color( 0.137255, 0.698039, 0.890196, 1 )
shader_param/Shirt2 = Color( 0.815686, 0.811765, 0.811765, 1 )
