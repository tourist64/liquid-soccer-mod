[gd_resource type="ShaderMaterial" load_steps=5 format=2]

[ext_resource path="res://Images/fananim.exr" type="Texture" id=1]
[ext_resource path="res://Images/fan.png" type="Texture" id=2]
[ext_resource path="res://Images/fan2.png" type="Texture" id=3]

[sub_resource type="Shader" id=1]
code = "shader_type spatial;
render_mode blend_mix,depth_draw_opaque,cull_back,diffuse_burley,specular_schlick_ggx;
uniform vec4 albedo : hint_color;
uniform sampler2D texture_albedo : hint_albedo;
uniform sampler2D texture_albedo2 : hint_albedo;
uniform sampler2D texture_anim : hint_albedo;
uniform float specular;
uniform float metallic;
uniform float roughness : hint_range(0,1);
uniform float point_size : hint_range(0,128);
uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;
uniform vec4 Skin : hint_color;
uniform vec4 Skin2 : hint_color;
uniform vec4 Shirt : hint_color;
uniform vec4 Shirt2 : hint_color;
uniform vec4 Shirt3 : hint_color;
uniform vec4 Shirt4 : hint_color;
uniform vec4 Shorts : hint_color;
uniform vec4 Shoes : hint_color;
uniform int kit;
uniform float frame=1.0;
uniform int doAnim;
varying vec4 idata;
vec4 texelGet ( sampler2D tg_tex, ivec2 tg_coord, int tg_lod ) {
	vec2 tg_texel = 1.0 / vec2(256.0);
	vec2 tg_getpos = (vec2(tg_coord) * tg_texel) + (tg_texel * 0.5);
	return texture(tg_tex, tg_getpos);
}

void vertex() {
	UV2.y = 1.0-UV2.y;
	idata=INSTANCE_CUSTOM;
	UV=UV*uv1_scale.xy+uv1_offset.xy;
	float fframe = 3.0/256.0;
	float fframe2= 3.0/256.0;
	if (doAnim > 0) {
		fframe = (mod (((TIME*0.8)+idata.g)*28.0,28.0)+1.0);
		fframe = mix(fframe,fframe+30.0,smoothstep(0.5,0.55,idata.b))/256.0;
	}
	vec3 pos = texture(texture_anim,vec2((UV2.x*181.0)/256.0,fframe),0).xyz;
	pos=(2.0*pos)-1.0;
	pos*=8.0;
	VERTEX = pos;
	
	
}




void fragment() {
	vec2 base_uv = UV;
	vec4 albedo_tex=vec4(1.0);
	
	albedo_tex = mix(texture(texture_albedo,base_uv), texture(texture_albedo2,base_uv),smoothstep(0.5,.51,idata.g));
	vec3 skin = mix(Skin.rgb,Skin2.rgb,idata.r);
	
	//albedo_tex *= COLOR;
	ALBEDO=mix(skin,Shoes.rgb,smoothstep(0.2,0.3,albedo_tex.r));
	ALBEDO=mix(ALBEDO,Shorts.rgb,smoothstep(0.4,0.75,albedo_tex.g));
	vec3 shirt = mix(Shirt.rgb,Shirt2.rgb,idata.g);
	shirt=mix(shirt,Shirt4.rgb,smoothstep(.8,.96,idata.a));
	shirt=mix(shirt,Shirt3.rgb,smoothstep(0.6,1.0,idata.b));
	
	
	ALBEDO=mix(ALBEDO,shirt,smoothstep(0.8,0.85,albedo_tex.r));
	ALBEDO=mix(ALBEDO,Shirt2.rgb,smoothstep(0.2,0.85,albedo_tex.b));
	
	METALLIC = metallic;
	ROUGHNESS = roughness;
	SPECULAR = specular;
}
"

[resource]
shader = SubResource( 1 )
shader_param/albedo = Color( 1, 1, 1, 1 )
shader_param/specular = 0.5
shader_param/metallic = 0.0
shader_param/roughness = 1.0
shader_param/point_size = 1.0
shader_param/uv1_scale = Vector3( 1, 1, 1 )
shader_param/uv1_offset = Vector3( 0, 0, 0 )
shader_param/uv2_scale = Vector3( 1, 1, 1 )
shader_param/uv2_offset = Vector3( 0, 0, 0 )
shader_param/Skin = Color( 0.752941, 0.552941, 0.552941, 1 )
shader_param/Skin2 = Color( 0.196078, 0.137255, 0.0588235, 1 )
shader_param/Shirt = Color( 0.521569, 0.0745098, 0.0745098, 1 )
shader_param/Shirt2 = Color( 0.768627, 0.701961, 0.160784, 1 )
shader_param/Shirt3 = Color( 0.815686, 0.815686, 0.815686, 1 )
shader_param/Shirt4 = Color( 0.168627, 0.278431, 0.192157, 1 )
shader_param/Shorts = Color( 0.129412, 0.227451, 0.337255, 1 )
shader_param/Shoes = null
shader_param/kit = 0
