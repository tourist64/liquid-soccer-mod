; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Camera",
"class": "InterpolatedCamera3D",
"language": "GDScript",
"path": "res://Scenes/Camera.gd"
} ]
_global_script_class_icons={
"InterpolatedCamera3D": ""
}

[application]

config/name="SuperLiquidSoccer"
run/main_scene="res://Scenes/goGame.tscn"
run/disable_stdout=true
run/disable_stderr=true
run/delta_sync_after_draw=true
boot_splash/image="res://Images/splash.png"
boot_splash/fullsize=false
boot_splash/bg_color=Color( 0.0941176, 0.215686, 0.321569, 1 )
config/icon="res://icon256.png"
config/windows_native_icon="res://icon.ico"

[autoload]

Global="*res://Scenes/Global.gd"
Helper="*res://Scenes/Helper.gd"
PokiSDK="*res://addons/poki-sdk/pokisdk.gd"

[debug]

settings/physics_interpolation/enable_warnings=false
shapes/collision/shape_color=Color( 0.937255, 0.705882, 0.462745, 0.509804 )

[display]

window/size/width=1031
window/size/height=580
window/size/resizable=false
window/vsync/use_vsync=false
window/stretch/mode="2d"
window/stretch/aspect="keep"

[editor_plugins]

enabled=PoolStringArray( "res://addons/poki-sdk/plugin.cfg" )

[global]

auto=false
verbose=false
batch=false

