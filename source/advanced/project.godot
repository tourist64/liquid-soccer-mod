[layer_names]

3d_physics/layer_1="Ground"
3d_physics/layer_2="Net"
3d_physics/layer_3="Ball"
3d_physics/layer_4="NetCatcher"
3d_physics/layer_5="PlayerTrap"
3d_physics/layer_6="Player"
3d_physics/layer_7="ScoreBox"
3d_physics/layer_8="PlayerBallCollider"
3d_physics/layer_9="Zone"
3d_physics/layer_10="ThreatArea1"
3d_physics/layer_11="ThreatArea2"
3d_physics/layer_12="Team1"
3d_physics/layer_13="Team2"
3d_physics/layer_17="KeeperCatch"
3d_physics/layer_18="Keeper save"
3d_physics/layer_23="post"

[physics]

3d/smooth_trimesh_collision=true
3d/physics_engine="Bullet"
3d/active_soft_world=false
3d/godot_physics/use_bvh=false
2d/use_bvh=false
3d/default_gravity=20.0
common/enable_object_picking=false

[rendering]

quality/driver/driver_name="GLES2"
quality/intended_usage/framebuffer_allocation.mobile=2
vram_compression/import_etc=true
quality/directional_shadow/size=2048
quality/directional_shadow/size.mobile=1024
quality/shadow_atlas/size=256
quality/shadow_atlas/size.mobile=256
quality/shadow_atlas/quadrant_1_subdiv=1
quality/shadow_atlas/quadrant_2_subdiv=2
quality/shadow_atlas/quadrant_3_subdiv=3
quality/reflections/texture_array_reflections=false
quality/reflections/high_quality_ggx=false
quality/shading/force_vertex_shading=true
quality/shading/force_lambert_over_burley=true
quality/shading/force_blinn_over_ggx=true
environment/default_clear_color=Color( 0, 0, 0, 1 )
quality/depth/hdr=false
environment/default_environment="res://default_env.tres"
quality/dynamic_fonts/use_oversampling=false
limits/rendering/max_renderable_lights=1
limits/rendering/max_renderable_reflections=1
limits/rendering/max_lights_per_object=1
